# Moat Finance — self-hosting environment
#
#   cp .env.self-host.example .env
#   ./scripts/self-host/generate-secrets.sh     # fills in the REQUIRED secrets below
#   docker compose up -d --build
#
# docker-compose.yml reads this file for every app container (env_file) and for
# ${...} interpolation. Only what self-hosting needs is listed here; see
# apps/api/.env.example for the full development reference.
# Full guide: docs/self-hosting.md

# ═══ REQUIRED ════════════════════════════════════════════════════════════════

# Password for the bundled Postgres container (generated).
POSTGRES_PASSWORD=

# Database connection. Leave both unset to use the bundled postgres service:
#   postgresql://moat:$POSTGRES_PASSWORD@postgres:5432/moat?schema=public
# Set them only to point at an external Postgres 16 (e.g. Neon, RDS).
# DATABASE_URL is the runtime/pooled URL; DIRECT_URL is used for migrations.
# DATABASE_URL=
# DIRECT_URL=

# Auth.js session signing secret, shared by web + api. (generated)
AUTH_SECRET=
# AES-256-GCM key for Plaid tokens and 2FA secrets: exactly 64 hex chars. (generated)
# Back this up — losing it makes stored provider tokens unreadable.
ENCRYPTION_KEY=
# Bearer token the cron container sends to /api/cron/*. (generated)
CRON_SECRET=
# Pepper for hashing MCP personal access tokens, 32+ chars. (generated)
MCP_TOKEN_PEPPER=

# Public URLs — what a browser (or AI client) uses to reach each service.
# Defaults work for http://localhost. Behind a reverse proxy set these to your
# https:// origins, then rebuild web (`docker compose build web`) because the
# API URL is baked into the browser bundle.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
PUBLIC_MCP_URL=http://localhost:3010

# Session cookie Domain attribute. Leave unset (host-only cookie) unless web and
# API are on sibling subdomains, e.g. app.example.com + api.example.com → .example.com
# AUTH_COOKIE_DOMAIN=

# Host ports published by docker compose.
WEB_PORT=3000
API_PORT=3001
MCP_PORT=3010

# ═══ SELF-HOST SWITCHES ══════════════════════════════════════════════════════

# Comma-separated emails allowed to use admin routes (community tip / prompt
# moderation). Empty = no admins.
ADMIN_EMAILS=

# Sign-up lock. Sign-ups are open unless SIGNUPS_ENABLED is exactly "false".
# Create your own account first, then set SIGNUPS_ENABLED=false so strangers
# can't create accounts (and link banks on your Plaid keys). Existing users and
# demo mode are unaffected. SIGNUP_ALLOWED_EMAILS (comma-separated,
# case-insensitive) may still sign up while sign-ups are closed.
SIGNUPS_ENABLED=
SIGNUP_ALLOWED_EMAILS=

# Comma-separated extra browser origins allowed to call the API (CORS), in
# addition to PUBLIC_WEB_URL. Example: https://moat.example.com,https://other.example.com
CORS_ALLOWED_ORIGINS=

# ═══ OPTIONAL INTEGRATIONS ═══════════════════════════════════════════════════
# Uncomment and fill in to enable (leave commented, not empty, when unused). Everything works without them except the feature noted.

# --- Plaid (automatic bank sync) with your own keys. You pay Plaid directly.
# Without it, use CSV import / manual accounts. Guide: docs/self-hosting.md
# Get keys at https://dashboard.plaid.com. PLAID_ENV: sandbox | production
# PLAID_CLIENT_ID=
# PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
# Public HTTPS URL Plaid posts webhooks to: $PUBLIC_API_URL/api/webhooks/plaid
# If unset, it is derived from PUBLIC_API_URL when that is https://; otherwise no
# webhook is registered and the daily cron jobs keep accounts up to date.
# PLAID_WEBHOOK=https://api.moat.example.com/api/webhooks/plaid
# Optional OAuth redirect URI. Leave unset for the web app (Plaid Link handles
# OAuth banks in a pop-up). If set, it must be allow-listed in the Plaid dashboard.
# PLAID_REDIRECT_URI=

# --- Google sign-in. Authorized redirect URI: $PUBLIC_WEB_URL/api/auth/callback/google
# Note: the API currently also requires AUTH_GOOGLE_ID_IOS in production
# whenever AUTH_GOOGLE_ID is set (any value works if you have no iOS app).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GOOGLE_ID_IOS=

# --- Resend (transactional email: invites, alerts, 2FA recovery)
# RESEND_API_KEY=
# EMAIL_FROM=
# FEEDBACK_RECIPIENT=

# --- OpenAI (AI categorization / insights)
# OPENAI_API_KEY=

# --- PostHog (analytics + feature flags). Without it, flags such as
# desktop-remote-mcp and amazon-retail-sync default OFF.
# NEXT_PUBLIC_* values are baked into the web bundle: rebuild web after changing.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# POSTHOG_API_KEY=
# POSTHOG_HOST=

# --- Axiom (structured log shipping). Without it, logs go to container stdout.
# AXIOM_TOKEN=
# AXIOM_DATASET=

# --- Upstash Redis (MCP rate limiting). Without it, MCP requests are not rate limited.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Logo.dev (institution logos in the UI). Baked into the web bundle.
# NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=
