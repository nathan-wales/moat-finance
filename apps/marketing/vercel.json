    {
      "source": "/security.html",
      "destination": "/security",
      "permanent": true
    },
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agents.html",
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/for/ai-agents.html",
      "destination": "/for/ai-agents",
      "permanent": true
    },
    {
      "source": "/for/self-employed.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/for-ai-agents.html",
      "destination": "/for/ai-agents",
      "permanent": true
    },
    {
      "source": "/for/ai",
      "destination": "/for/ai-agents",
