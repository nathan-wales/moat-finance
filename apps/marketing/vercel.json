    {
      "source": "/for-ai.html",
      "destination": "/for/ai-agents",
      "permanent": true
    },
    {
      "source": "/for-self-employed.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "for",
          "value": "agents"
        }
      ],
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/llms",
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/llms.txt",
      "destination": "/agents",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
