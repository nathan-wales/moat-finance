{
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/for/ai-agents",
      "destination": "/for/ai-agents.html"
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "/#quickstart",
