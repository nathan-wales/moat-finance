    },
    {
      "source": "/download.html",
      "destination": "/#quickstart",
      "permanent": false
    },
    {
      "source": "/windows",
      "destination": "/#quickstart",
      "permanent": false
    },
    {
      "source": "/windows.html",
      "destination": "/#quickstart",
      "permanent": false
    },
    {
      "source": "/for/local",
      "destination": "/#quickstart",
      "permanent": false
    },
    {
      "source": "/for/local.html",
      "destination": "/#quickstart",
      "permanent": false
    },
    {
      "source": "/for-local.html",
      "destination": "/#quickstart",
      "permanent": false
    },
    {
      "source": "/local",
      "destination": "/#quickstart",
      "permanent": false
    },
    {
      "source": "/local/(.*)",
      "destination": "/#quickstart",
      "permanent": false
