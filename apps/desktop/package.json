{
	"name": "moat-desktop",
	"private": true,
	"version": "0.1.47",
	"description": "Moat Finance Desktop — local-first Electron app",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "pnpm --filter @moat/db-sqlite run db:generate && node ./scripts/brand-electron-macos.mjs && electron-vite dev",
		"postinstall": "node ./scripts/brand-electron-macos.mjs",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"prepare-dist": "pnpm run build:claude-mcp-proxy && pnpm --filter @moat/db-sqlite run db:generate && node ./scripts/copy-sqlcipher-prebuilds.mjs && pnpm run build",
		"validate:prisma": "node ./scripts/validate-packaged-prisma.mjs",
		"dist:mac": "pnpm run prepare-dist && bash ./scripts/run-mac-builder.sh electron-builder --mac && pnpm run validate:prisma",
		"dist:win": "pnpm run prepare-dist && electron-builder --win && pnpm run validate:prisma",
		"dist:linux": "pnpm run prepare-dist && electron-builder --linux",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"test": "tsx --test $({ find src/main -maxdepth 1 -name '*.test.ts'; find src/main/agent-gateway src/main/ipc src/main/lib src/main/vault src/main/db src/main/retirement src/main/remote-mcp -name '*.test.ts'; find src/main/plaid -maxdepth 1 -name '*.test.ts'; } | sort)",
		"test:plaid-golden": "pnpm --filter @moat/db-sqlite run db:generate && tsx --test --test-concurrency=1 src/main/plaid/golden/golden-ledger.test.ts src/main/plaid/golden/reconnect-ledger.test.ts",
		"ensure-electron": "node ./scripts/ensure-electron.mjs",
		"test:e2e:plaid-golden": "playwright test -c playwright.config.mts",
		"test:plaid-sandbox-smoke": "tsx --test src/main/plaid/sandbox-smoke.test.ts",
		"build:claude-mcp-proxy": "node ./scripts/build-claude-mcp-proxy.mjs",
		"wipe:local": "./scripts/wipe-local-install.sh",
		"wipe:local:dry-run": "./scripts/wipe-local-install.sh --dry-run"
	},
	"dependencies": {
		"better-sqlite3-multiple-ciphers": "13.0.3",
		"electron-updater": "^6.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"@electron-toolkit/preload": "^3.0.1",
		"@electron-toolkit/utils": "^4.0.0",
		"@moat/ai-prompts": "workspace:*",
		"@moat/category-mapping": "workspace:*",
		"@moat/charts": "workspace:*",
		"@moat/contracts": "workspace:*",
		"@moat/data-access": "workspace:*",
		"@moat/db-sqlite": "workspace:*",
		"@moat/domain": "workspace:*",
		"@moat/events": "workspace:*",
		"@moat/features": "workspace:*",
		"@moat/feedback": "workspace:*",
		"@moat/financial-data-providers": "workspace:*",
		"@moat/logging": "workspace:*",
		"@moat/mcp-contracts": "workspace:*",
		"@moat/monitoring-rules": "workspace:*",
		"@moat/plaid-golden-ledger": "workspace:*",
		"@moat/reports": "workspace:*",
		"@moat/retail-sync": "workspace:*",
		"@moat/runtime": "workspace:*",
		"@moat/ui": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@playwright/test": "^1.55.0",
		"@prisma/client": "^6.19.3",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-slider": "^1.3.6",
		"@tailwindcss/vite": "^4.0.15",
		"@tanstack/react-query": "^5.69.0",
		"@types/node": "^20.14.10",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"electron": "^36.3.1",
		"electron-builder": "^26.0.12",
		"electron-vite": "^3.1.0",
		"esbuild": "^0.25.12",
		"framer-motion": "^12.38.0",
		"leaflet": "^1.9.4",
		"linkedom": "^0.18.12",
		"lucide-react": "^0.577.0",
		"plaid": "^41.4.0",
		"posthog-js": "^1.369.3",
		"posthog-node": "^4.18.0",
		"radix-ui": "^1.6.7",
		"react": "^19.0.0",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.0.0",
		"react-plaid-link": "^4.1.1",
		"recharts": "^3.8.0",
		"shadcn": "^4.0.5",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.0",
		"tailwindcss": "^4.0.15",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.8.2",
		"vite": "^6.3.5",
		"ws": "^8.21.3",
		"zustand": "^5.0.12"
	},
	"build": {
		"appId": "com.moatfinance.desktop",
		"productName": "Moat Finance",
		"directories": {
			"output": "dist"
		},
		"files": [
			"out/**/*",
			"!out/**/*.map"
		],
		"extraResources": [
			{
				"from": "../../packages/db-sqlite/src/generated/client",
				"to": "prisma-client",
				"filter": [
					"index.js",
					"default.js",
					"client.js",
					"package.json",
					"schema.prisma",
					"libquery_engine*",
					"query_engine-windows.dll.node",
					"runtime/library.js"
				]
			},
			{
				"from": "resources/claude-mcpb",
				"to": "claude-mcpb"
			},
			{
				"from": "resources/sqlcipher-native",
				"to": "sqlcipher-native"
			}
		],
		"asarUnpack": [
			"**/*.node"
		],
		"mac": {
			"category": "public.app-category.finance",
			"icon": "build/icon.icns",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"x64",
						"arm64"
					]
				}
			],
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"forceCodeSigning": true,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist"
		},
		"win": {
			"icon": "build/icon.ico",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"linux": {
			"icon": "build/icon.png",
			"target": [
				"AppImage"
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true
		},
		"publish": {
			"provider": "generic",
			"url": "https://downloads.moatfinance.ai/updates"
		}
	}
}
