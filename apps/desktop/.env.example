# Plaid credentials — required for bank connection features.
# Get sandbox credentials at: https://dashboard.plaid.com/developers/keys
#
# For development: copy this file to .env and fill in your values.
# For distribution builds: set these as CI environment variables.
# End users do NOT need to configure this — credentials are baked in at build time.

PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Cloud API base URL — used for public endpoints (vault recovery, desktop
# feedback). Dev defaults to http://localhost:3001 when unset.
# MOAT_API_URL="http://localhost:3001"
# VITE_MOAT_API_URL="http://localhost:3001"
# Web app base URL for browser link-outs (build-time). Unset → hosted app.
# MOAT_WEB_URL="http://localhost:3000"

# PostHog (feature flags + analytics). Public project key.
# Local desktop also reads NEXT_PUBLIC_POSTHOG_KEY / NEXT_PUBLIC_POSTHOG_HOST
# from apps/web/.env and apps/api/.env when these are unset.
# VITE_POSTHOG_KEY=""
# VITE_POSTHOG_HOST="https://us.posthog.com"

# Unpackaged dev only. Packaged builds ignore this and use the PostHog flag
# desktop-remote-mcp. Set to 1 to exercise the remote MCP tunnel locally.
# MOAT_DESKTOP_REMOTE_MCP=1
# REMOTE_MCP_TUNNEL_URL=ws://localhost:8787/connect
