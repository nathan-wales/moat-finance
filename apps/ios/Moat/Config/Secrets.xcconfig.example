// Optional local overrides (gitignored as Secrets.xcconfig).
// Copy to Secrets.xcconfig and uncomment values as needed.
//
// Institution logos — run from apps/ios: ./scripts/sync-secrets-from-web-env.sh
// (copies NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY from apps/web/.env), or set manually:
// LOGO_DEV_PUBLISHABLE_KEY = pk_your_key_here
//
// Release Google Sign-In — only if different from Release.xcconfig defaults
// GID_CLIENT_ID = your-ios-client-id.apps.googleusercontent.com
// GID_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-ios-client-id
//
// Physical device API (same Wi-Fi as your Mac):
// Find your Mac's IP: System Settings → Wi-Fi → Details, or `ipconfig getifaddr en0`
// API must be running with LAN access: pnpm --filter moat-api dev (binds 0.0.0.0)
//
// API_BASE_URL = http:\/\/192.168.0.XXX:3001
// WEB_BASE_URL = http:\/\/192.168.0.XXX:3000
