    name                     String
    officialName             String?
    mask                     String?
    type                     String
    subtype                  String?
    currentBalance           Float?
    availableBalance         Float?
    currency                 String    @default("USD")
    monthlyContribution      Float     @default(0)
    annualReturnRate         Float     @default(0.07)
    notes                    String?
    forecastInputsUserEdited Boolean   @default(false)
    investmentHidden         Boolean   @default(false)
    accountHidden            Boolean   @default(false)
    isActive                 Boolean   @default(true)
    syncEnabled              Boolean   @default(true)
    lastBalanceSyncAt        DateTime?
    transactionsSyncedThrough DateTime?

    user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    plaidItem             PlaidItem              @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
    transactions          Transaction[]
    realEstateInvestments RealEstateInvestment[]
    holdings              PlaidHolding[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([plaidItemId])
}

/// Per-security positions from Plaid Investments (/investments/holdings/get).
/// Security metadata is denormalized onto the row because Plaid returns it with
/// every holdings response and it is only ever read for display.
model PlaidHolding {
    id             String    @id @default(cuid())
    userId         String
    plaidAccountId String
    securityId     String
    name           String?
    tickerSymbol   String?
    securityType   String?
    quantity       Float
    price          Float?
    priceAsOf      DateTime?
    value          Float
    costBasis      Float?
    currency       String    @default("USD")
    syncedAt       DateTime

    user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    plaidAccount PlaidAccount @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([plaidAccountId, securityId])
    @@index([userId])
    @@index([plaidAccountId])
}

// ─── Balance Snapshots ────────────────────────────────────────────────────────

enum BalanceSnapshotSource {
