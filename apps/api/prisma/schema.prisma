// ─── Retirement ───────────────────────────────────────────────────────────────

enum RetirementScenarioSource {
    USER
    SUGGESTED
    AI
    GOAL_SEEK
}

enum RetirementSpendingTreatment {
    REMAINS
    DISAPPEARS
    CHANGES
}

enum RetirementSpendingEssentiality {
    ESSENTIAL
    FLEXIBLE
}

/// Per-user retirement inputs that cannot be derived from transactions,
/// accounts, or the financial profile. Everything derivable stays derived.
model RetirementPlan {
    id     String @id @default(cuid())
    userId String @unique

    primaryBirthYear           Int?
    targetRetirementAge        Int      @default(65)
    longevityAge               Int      @default(95)
    socialSecurityClaimAge     Int      @default(67)
    socialSecurityMonthlyAtFra Decimal? @db.Decimal(14, 2)

    hasSpouse                        Boolean  @default(false)
    spouseBirthYear                  Int?
    spouseRetirementAge              Int?
    spouseLongevityAge               Int?
    spouseSocialSecurityClaimAge     Int?
    spouseSocialSecurityMonthlyAtFra Decimal? @db.Decimal(14, 2)
    /// Annual employment income override; null derives from trailing cash flow.
    annualEmploymentIncome           Decimal? @db.Decimal(14, 2)
    annualSpouseEmploymentIncome     Decimal? @db.Decimal(14, 2)

    confidenceTarget Float @default(0.85)
    monteCarloTrials Int   @default(1000)

    /// RetirementSpendingStage[] — ageFrom, ageTo, monthlyAmount, label
    spendingStages Json @default("[]")
    /// Nullable per-field overrides of the derived retirement spending estimate
    spendingOverrides Json @default("{}")
    /// Which milestones the user has dismissed or pinned on the timeline
    timelinePreferences Json @default("{}")
    /// Ordered withdrawal sequencing across taxable / taxDeferred / taxFree
    withdrawalOrder Json @default("[\"taxable\",\"taxDeferred\",\"taxFree\"]")

    /// Singleton baseline policies. Each is a Zod-validated blob; an empty
    /// object means "unset", and an unset policy projects exactly as the engine
    /// did before policies existed.
    /// ContributionPolicy — per-person 401(k)/IRA/HSA modes, match tiers, gross comp
    contributionPolicy Json @default("{}")
    /// SpendingPolicy — % of current lifestyle at retirement, go-go/slow-go/no-go phases
    spendingPolicy Json @default("{}")
    /// HealthcarePolicy — pre-Medicare premium, Medicare start + cost, healthcare inflation
    healthcarePolicy Json @default("{}")
    /// TaxPolicy — current/retirement state, Roth conversion strategy
    taxPolicy Json @default("{}")
    /// CashPolicy — target reserve and where excess cash and RMD proceeds go
    cashPolicy Json @default("{}")
    /// AllocationPolicy — target equity share and glide path
    allocationPolicy Json @default("{}")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
    scenarios    RetirementScenario[]
    standingRules RetirementStandingRule[]

    @@index([userId])
}

/// A baseline assumption that stands until changed: a pension, an annuity, a
/// recurring income or expense. Levers answer "what if"; standing rules
/// describe how the household's financial life normally works. Mirrors
/// `RetirementScenarioLever`'s `{ kind, params }` shape so both can share one
/// registry mechanism.
model RetirementStandingRule {
    id     String @id @default(cuid())
    userId String
    planId String
    /// RetirementStandingRuleKind, e.g. "PENSION", "RECURRING_EXPENSE"
    kind   String
    label  String
    /// Zod-validated params for that discriminant
    params Json
    /// Where the numbers came from: detected | assumed | profile | userEdited
    source    String  @default("userEdited")
    enabled   Boolean @default(true)
    sortOrder Int     @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    plan RetirementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([planId, sortOrder])
}

model RetirementScenario {
    id          String                   @id @default(cuid())
    userId      String
    planId      String
    name        String
    description String?
    color       String?
    source      RetirementScenarioSource @default(USER)
    isPinned    Boolean                  @default(false)
    sortOrder   Int                      @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
    plan   RetirementPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
    levers RetirementScenarioLever[]

    @@index([userId])
    @@index([planId, sortOrder])
}

model RetirementScenarioLever {
    id         String @id @default(cuid())
    scenarioId String
    /// RetirementLeverType discriminant, e.g. "retire_at_age", "max_roth_ira"
    type       String
    /// Zod-validated params for that discriminant
    params     Json
    enabled    Boolean @default(true)
    sortOrder  Int     @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    scenario RetirementScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

    @@index([scenarioId, sortOrder])
}

/// Per-category retirement spending classification. Reuses the existing
/// Category taxonomy rather than introducing a parallel one.
model RetirementSpendingCategoryPlan {
    id           String                         @id @default(cuid())
    userId       String
    categoryId   String
    treatment    RetirementSpendingTreatment
    essentiality RetirementSpendingEssentiality
    /// Overrides the derived retirement monthly amount when the user disagrees
    retirementMonthlyAmount Decimal? @db.Decimal(14, 2)
    isUserEdited            Boolean  @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, categoryId])
    @@index([userId])
}

