    accountId String?
    mapping   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

// ─── Agent Models (Moat Finance AI) ────────────────────────────────────────────────────

model AgentConversation {
    id          String   @id @default(cuid())
    userId      String
    householdId String?
    title       String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    messages       AgentMessage[]
    runs           AgentRun[]
    timelineBlocks AgentTimelineBlock[]
    widgetActions  AgentWidgetAction[]

    @@index([userId])
    @@index([householdId])
}

model AgentMessage {
    id             String           @id @default(cuid())
    conversationId String
    role           AgentMessageRole
    content        String           @db.Text
    metadata       Json?
    createdAt      DateTime         @default(now())

    conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId])
}

model AgentRun {
    id                    String         @id @default(cuid())
    conversationId        String
    userId                String
    householdId           String?
    clientRequestId       String?
    status                AgentRunStatus
    kind                  AgentRunKind   @default(chat)
    model                 String?
    provider              String?
    providerResponseId    String?
    promptVersion         String?
    agentVersion          String?
    toolRegistryVersion   String?
    streamProtocolVersion String?
    inputTokens           Int?
    outputTokens          Int?
    errorCode             String?
    errorMessage          String?        @db.Text
    createdAt             DateTime       @default(now())
    startedAt             DateTime?
    completedAt           DateTime?
    cancelledAt           DateTime?

    conversation   AgentConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    steps          AgentRunStep[]
    toolCalls      AgentToolCall[]
    timelineBlocks AgentTimelineBlock[]
    widgetActions  AgentWidgetAction[]

    @@unique([userId, clientRequestId])
    @@index([conversationId])
    @@index([userId])
    @@index([householdId])
}

model AgentRunStep {
    id                 String             @id @default(cuid())
    runId              String
    stepIndex          Int
    type               AgentRunStepType
    status             AgentRunStepStatus
    providerResponseId String?
    input              Json?
    output             Json?
    errorCode          String?
    errorMessage       String?            @db.Text
    createdAt          DateTime           @default(now())
    completedAt        DateTime?

    run            AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
    toolCalls      AgentToolCall[]
    timelineBlocks AgentTimelineBlock[]
    widgetActions  AgentWidgetAction[]

    @@unique([runId, stepIndex])
    @@index([runId])
}

model AgentToolCall {
    id           String              @id @default(cuid())
    runId        String
    stepId       String?
    toolCallId   String
    toolName     String
    input        Json?
    output       Json?
    status       AgentToolCallStatus
    errorCode    String?
    errorMessage String?             @db.Text
    createdAt    DateTime            @default(now())
    completedAt  DateTime?

    run  AgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
    step AgentRunStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

    @@unique([runId, toolCallId])
    @@index([runId])
    @@index([stepId])
    @@index([toolName])
}

model AgentTimelineBlock {
    id             String  @id @default(cuid())
    conversationId String
    runId          String?
    stepId         String?

    role String
    type String

    content String? @db.Text
    data    Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    run          AgentRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
    step         AgentRunStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull)

    @@index([conversationId])
    @@index([runId])
    @@index([stepId])
}

model AgentWidgetAction {
    id String @id @default(cuid())

    conversationId String
    widgetId       String
    runId          String?
    stepId         String?

    userId      String
    householdId String?

    actionType String
    input      Json
    output     Json?

    status String

    clientRequestId String?

    createdAt   DateTime  @default(now())
    completedAt DateTime?

    conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    run          AgentRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
    step         AgentRunStep?     @relation(fields: [stepId], references: [id], onDelete: SetNull)

    @@unique([widgetId, actionType, clientRequestId])
    @@index([conversationId])
    @@index([widgetId])
    @@index([userId])
    @@index([householdId])
    @@index([runId])
    @@index([stepId])
}

enum AgentMessageRole {
    user
    assistant
    system
    tool
}

enum AgentRunStatus {
    queued
    running
    completed
    failed
    cancelled
    waiting_for_user
}

enum AgentRunKind {
    chat
    widget_action
}

enum AgentRunStepType {
    model_response
    tool_execution
    user_input_required
}

enum AgentRunStepStatus {
    running
    completed
    failed
    cancelled
}

enum AgentToolCallStatus {
    running
    completed
    failed
    skipped
    cancelled
}

// ─── AI Reports ───────────────────────────────────────────────────────────────

enum ReportVisibility {
    PRIVATE
    SHARE_LINK
    PUBLIC
}

model AiReport {
    id            String           @id @default(cuid())
    userId        String
    title         String
    description   String?
    // V1 legacy fields (kept for backward compatibility)
    sanitizedHtml String           @db.Text
    sanitizedCss  String           @db.Text
    visibility    ReportVisibility @default(PRIVATE)
    shareSlug     String?          @unique
    // V2 Canvas fields
    document      Json?
    createdBy     String           @default("AGENT")
    createdAt     DateTime         @default(now())
    updatedAt     DateTime         @updatedAt
    deletedAt     DateTime?

    user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    versions AiReportVersion[]
    shares   AiReportShare[]

    @@index([userId])
    @@index([visibility])
    @@index([shareSlug])
    @@index([userId, deletedAt])
}

model AiReportShare {
    id            String    @id @default(cuid())
    reportId      String
    userId        String
    shareSlug     String    @unique
    title         String
    description   String?
    document      Json?
    // V1 legacy snapshot fields
    sanitizedHtml String    @db.Text
    sanitizedCss  String    @db.Text
    isEnabled     Boolean   @default(true)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    revokedAt     DateTime?

    report AiReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
    user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([reportId])
    @@index([userId])
    @@index([shareSlug])
}

model AiReportVersion {
    id            String   @id @default(cuid())
    reportId      String
    title         String
    description   String?
    // V1 legacy
    sanitizedHtml String   @db.Text
    sanitizedCss  String   @db.Text
    // V2 Canvas
    document      Json?
    createdAt     DateTime @default(now())

    report AiReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

    @@index([reportId])
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

model Feedback {
    id          String         @id @default(cuid())
    userId      String?
    householdId String?
    type        FeedbackType   @default(GENERAL)
    source      FeedbackSource
    status      FeedbackStatus @default(NEW)

    message    String  @db.Text
    route      String?
    appVersion String?
    platform   String?
    userAgent  String? @db.Text
    metadata   Json?

    screenshotUrl      String?
    screenshotPath     String?
    screenshotMimeType String?

    githubIssueNumber Int?
    githubIssueUrl    String?
    githubSyncStatus  GitHubSyncStatus?
    githubSyncError   String?           @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([householdId])
    @@index([source])
    @@index([status])
    @@index([createdAt])
}

enum FeedbackType {
    GENERAL
    BUG
    FEATURE_REQUEST
    UX_FEEDBACK
    MCP_TOOL_ISSUE
    INCORRECT_RESULT
    OTHER
}

enum FeedbackSource {
    WEB_APP
    DESKTOP_APP
    MCP
}

enum FeedbackStatus {
    NEW
    REVIEWED
    PLANNED
    IN_PROGRESS
    RESOLVED
    CLOSED
}

enum GitHubSyncStatus {
    NOT_SYNCED
    SYNCED
    FAILED
}

model WindowsWaitlist {
    id        String   @id @default(uuid())
    email     String   @unique
    createdAt DateTime @default(now())
    ipAddress String?
    userAgent String?

    @@index([email])
}

enum BetaAllowlistSource {
    SEED
    MANUAL
}

enum BetaAccessRequestStatus {
    PENDING
    REVIEWED
}

model BetaAllowlist {
    id        String              @id @default(cuid())
    email     String              @unique
    source    BetaAllowlistSource @default(MANUAL)
    createdAt DateTime            @default(now())

    @@index([email])
}

model BetaAccessRequest {
    id        String                  @id @default(cuid())
    email     String                  @unique
    reason    String                  @db.Text
    userId    String?
    status    BetaAccessRequestStatus @default(PENDING)
    createdAt DateTime                @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([email])
    @@index([status])
}

model DesktopVaultRecoveryRegistration {
    id               String   @id @default(cuid())
    recoveryDeviceId String   @unique
    emailHash        String
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@index([emailHash])
}

model DesktopVaultRecoveryCode {
    id               String    @id @default(cuid())
    recoveryDeviceId String
    codeHash         String
    expiresAt        DateTime
    attemptCount     Int       @default(0)
    consumedAt       DateTime?
    createdAt        DateTime  @default(now())

    @@index([recoveryDeviceId, expiresAt])
}

model DesktopVaultRecoveryToken {
    id               String    @id @default(cuid())
    recoveryDeviceId String
    tokenHash        String    @unique
    expiresAt        DateTime
    consumedAt       DateTime?
    createdAt        DateTime  @default(now())

    @@index([recoveryDeviceId, expiresAt])
}

/// Short-lived PKCE pairing row for desktop → web Google sign-in.
/// Tokens are never stored here; claim mints AuthSession tokens once.
model DesktopAuthPair {
