// ─── Community Prompt Library ─────────────────────────────────────────────────

enum PromptVisibility {
    PRIVATE
    PUBLIC
}

enum PromptReviewStatus {
    NOT_SUBMITTED
    PENDING
    CHANGES_REQUESTED
    APPROVED
    REJECTED
}

enum PromptModerationAction {
    SUBMITTED
    WITHDRAWN
    APPROVED
    CHANGES_REQUESTED
    REJECTED
    UNPUBLISHED
}

enum PromptLibrarySource {
    CURATED
    MINE
    COMMUNITY
}

model PromptCategory {
    id        String   @id @default(cuid())
    slug      String   @unique
    label     String
    sortOrder Int      @default(0)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    prompts   UserPrompt[]
    revisions PromptRevision[]
}

model UserPrompt {
    id                      String             @id @default(cuid())
    creatorId               String
    title                   String
    description             String?
    body                    String             @db.Text
    categoryId              String?
    tags                    String[]
    visibility              PromptVisibility   @default(PRIVATE)
    reviewStatus            PromptReviewStatus @default(NOT_SUBMITTED)
    moderationFeedback      String?            @db.Text
    rejectionReason         String?            @db.Text
    submittedAt             DateTime?
    reviewedAt              DateTime?
    reviewedById            String?
    publishedAt             DateTime?
    requiredConnections     String[]           @default([])
    requiredDataScopes      String[]           @default([])
    sourcePromptId          String?
    sourceRevisionId        String?
    sourceCommunityPromptId String?
    publishedRevisionId     String?            @unique
    deletedAt               DateTime?
    createdAt               DateTime           @default(now())
    updatedAt               DateTime           @updatedAt

    creator           User                   @relation("PromptCreator", fields: [creatorId], references: [id], onDelete: Cascade)
    reviewer          User?                  @relation("PromptReviewer", fields: [reviewedById], references: [id])
    category          PromptCategory?        @relation(fields: [categoryId], references: [id])
    publishedRevision PromptRevision?        @relation("PublishedRevision", fields: [publishedRevisionId], references: [id])
    revisions         PromptRevision[]       @relation("PromptRevisions")
    moderationHistory PromptModerationEvent[]

    @@index([creatorId])
    @@index([visibility, reviewStatus])
    @@index([categoryId])
    @@index([submittedAt])
    @@index([publishedAt])
    @@index([creatorId, deletedAt])
}

model PromptRevision {
    id                  String             @id @default(cuid())
    promptId            String
    version             Int
    title               String
    description         String?
    body                String             @db.Text
    categoryId          String?
    tags                String[]
    reviewStatus        PromptReviewStatus @default(NOT_SUBMITTED)
    moderationFeedback  String?            @db.Text
    rejectionReason     String?            @db.Text
    submittedAt         DateTime?
    reviewedAt          DateTime?
    reviewedById        String?
    requiredConnections String[]           @default([])
    requiredDataScopes  String[]           @default([])
    createdAt           DateTime           @default(now())
    updatedAt           DateTime           @updatedAt

    prompt       UserPrompt      @relation("PromptRevisions", fields: [promptId], references: [id], onDelete: Cascade)
    category     PromptCategory? @relation(fields: [categoryId], references: [id])
    publishedFor UserPrompt?     @relation("PublishedRevision")
    reviewer     User?           @relation("PromptRevisionReviewer", fields: [reviewedById], references: [id])

    @@unique([promptId, version])
    @@index([promptId, reviewStatus])
    @@index([submittedAt])
}

model PromptModerationEvent {
    id         String                 @id @default(cuid())
    promptId   String
    revisionId String?
    actorId    String
    action     PromptModerationAction
    feedback   String?                @db.Text
    reason     String?                @db.Text
    metadata   Json?
    createdAt  DateTime               @default(now())

    prompt UserPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

    @@index([promptId, createdAt])
    @@index([action])
}

model PromptPin {
    id       String              @id @default(cuid())
    userId   String
    source   PromptLibrarySource
    promptId String
    pinnedAt DateTime            @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, source, promptId])
    @@index([userId, source, pinnedAt])
}

model PromptLaunchStat {
    id          String              @id @default(cuid())
    source      PromptLibrarySource
    promptId    String
    launchCount Int                 @default(0)

    @@unique([source, promptId])
    @@index([source, launchCount])
}

model PromptLaunchDaily {
    id         String              @id @default(cuid())
    userId     String
    source     PromptLibrarySource
    promptId   String
    launchDate DateTime            @db.Date

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, source, promptId, launchDate])
    @@index([userId, source, launchDate])
}

// ─── Community Tips ───────────────────────────────────────────────────────────

enum CommunityTipAttribution {
    PUBLIC
    ANONYMOUS
}

enum CommunityTipStatus {
    LLM_REVIEW
    PENDING_ADMIN_REVIEW
    CHANGES_REQUIRED
    APPROVED
    REJECTED
    ARCHIVED
    EXPIRED
}

model CommunityTip {
    id                   String                   @id @default(cuid())
    authorUserId         String
    title                String
    body                 String                   @db.Text
    attribution          CommunityTipAttribution  @default(PUBLIC)
    status               CommunityTipStatus       @default(LLM_REVIEW)
    moderationReason     String?                  @db.Text
    moderationMetadata   Json?
    llmReview            Json?
    llmReviewStartedAt   DateTime?
    llmReviewCompletedAt DateTime?
    reviewedById         String?
    reviewedAt           DateTime?
    publishedAt          DateTime?
    expiresAt            DateTime?
    keywords             String[]                 @default([])
    normalizedKeywords   String[]                 @default([])
    merchantNames        String[]                 @default([])
    normalizedMerchantNames String[]              @default([])
    transactionCategories String[]                @default([])
    tags                 String[]                 @default([])
    tipType              String?
    potentialBenefit     String?
    estimatedSavingsPercent Decimal?              @db.Decimal(5, 2)
    estimatedSavingsAmount  Decimal?              @db.Decimal(14, 2)
    countryCodes         String[]                 @default([])
    requirements         String[]                 @default([])
    externalUrl          String?
    personallyTested     Boolean                  @default(false)
    likeCount            Int                      @default(0)
    submissionFingerprint String?
    deletedAt            DateTime?
    createdAt            DateTime                 @default(now())
    updatedAt            DateTime                 @updatedAt

    author    User               @relation("CommunityTipAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
    reviewer  User?              @relation("CommunityTipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
    likes     CommunityTipLike[]

    @@index([status, publishedAt])
    @@index([authorUserId, createdAt])
    @@index([status, createdAt])
    @@index([expiresAt])
    @@index([submissionFingerprint])
    @@index([authorUserId, submissionFingerprint])
}

model CommunityTipLike {
    id        String   @id @default(cuid())
    tipId     String
    userId    String
    createdAt DateTime @default(now())

    tip  CommunityTip @relation(fields: [tipId], references: [id], onDelete: Cascade)
    user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([tipId, userId])
    @@index([userId, createdAt])
}

// ─── Notifications / Financial Monitoring ────────────────────────────────────

enum NotificationSignalType {
    TRANSACTION_APPEARED
    EXPECTED_TRANSACTION_MISSING
    BUDGET_THRESHOLD
    BALANCE_THRESHOLD
    LARGE_TRANSACTION
    RECURRING_AMOUNT_CHANGED
    UPCOMING_RECURRING_BILL
    ACCOUNT_SYNC_STALE
    SCHEDULED_SUMMARY
}

enum NotificationChannel {
    EMAIL
    PUSH
    IN_APP
}

enum NotificationUrgency {
    CRITICAL
    IMPORTANT
    INFORMATIONAL
}

enum PushPrivacyLevel {
    HIDE_DETAILS
    GENERAL_DETAILS
    SHOW_AMOUNTS
}

enum NotificationDeliveryResult {
    SENT
    FAILED
    SUPPRESSED
    DEDUPED
    SHADOW
}

enum NotificationResolutionStatus {
    UNRESOLVED
    RESOLVED
    SNOOZED
    MUTED
}

model NotificationRule {
    id                   String                 @id @default(cuid())
    userId               String
    name                 String
    plainLanguageSummary String?
    signalType           NotificationSignalType
    trigger              Json
    conditions           Json
    schedule             Json
    watchQuery           Json?
    channels             NotificationChannel[]
    urgency              NotificationUrgency    @default(IMPORTANT)
    isActive             Boolean                @default(true)
    isPaused             Boolean                @default(false)
    templateId           String?
    source               String                 @default("manual")
    sourceAttribution    String?
    lastEvaluatedAt      DateTime?
    lastFiredAt          DateTime?
    lastFiredStateHash   String?
    fireCount            Int                    @default(0)
    createdAt            DateTime               @default(now())
    updatedAt            DateTime               @updatedAt

    user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    deliveries NotificationDelivery[]

    @@index([userId, isActive, isPaused])
    @@index([signalType, isActive])
}

model NotificationPreference {
    id                                String                @id @default(cuid())
    userId                            String                @unique
    timezone                          String                @default("America/New_York")
    pushPrivacyLevel                  PushPrivacyLevel      @default(HIDE_DETAILS)
    quietHoursEnabled                 Boolean               @default(false)
    quietHoursStartMinute             Int                   @default(1320)
    quietHoursEndMinute               Int                   @default(480)
    maxPushPerDay                     Int                   @default(10)
    weeklySummaryEnabled              Boolean               @default(true)
    weeklySummaryDayOfWeek            Int                   @default(1)
    weeklySummaryMinuteOfDay          Int                   @default(480)
    weeklySummaryChannels             NotificationChannel[] @default([EMAIL, IN_APP])
    weeklySummaryReportingPeriod      String                @default("previous_calendar_week")
    weeklySummaryIncludeAiObservations Boolean              @default(true)
    weeklySummaryAccountIds           String[]              @default([])
    weeklySummarySections             String[]              @default([])
    emailEnabled                      Boolean               @default(true)
    pushEnabled                       Boolean               @default(true)
    inAppEnabled                      Boolean               @default(true)
    onboardingSummaryAcknowledgedAt   DateTime?
    createdAt                         DateTime              @default(now())
    updatedAt                         DateTime              @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
    id               String                       @id @default(cuid())
    userId           String
    ruleId           String?
    title            String
    body             String
    channels         NotificationChannel[]
    deliveryResult   NotificationDeliveryResult
    failureReason    String?
    explanation      Json
    linkedData       Json?
    evaluationWindow String
    dedupeKey        String                       @unique
    stateHash        String?
    readAt           DateTime?
    resolvedAt       DateTime?
    resolutionStatus NotificationResolutionStatus @default(UNRESOLVED)
    snoozedUntil     DateTime?
    isWeeklySummary  Boolean                      @default(false)
    createdAt        DateTime                     @default(now())

    user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    rule NotificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt])
    @@index([userId, readAt])
    @@index([ruleId, createdAt])
}

model DevicePushToken {
    id               String    @id @default(cuid())
    userId           String
    token            String
    platform         String    @default("ios")
    appVersion       String?
    lastRegisteredAt DateTime  @default(now())
    revokedAt        DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, token])
    @@index([userId, revokedAt])
}

model NotificationSuggestion {
    id            String    @id @default(cuid())
    userId        String
    suggestionKey String
    title         String
    description   String
    templateId    String
    prefill       Json
    dismissedAt   DateTime?
    createdAt     DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, suggestionKey])
    @@index([userId, dismissedAt])
}

model ExpectedRecurringEvent {
    id                     String    @id @default(cuid())
    userId                 String
    label                  String
    matchCriteria          Json
    cadence                String
    expectedWindowStartDay Int?
    expectedWindowEndDay   Int?
    missingAfterDay        Int?
    amount                 Float?
    accountIds             String[]  @default([])
    isActive               Boolean   @default(true)
    lastMatchedAt          DateTime?
    createdAt              DateTime  @default(now())
    updatedAt              DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, isActive])
}

// ─── Taxes ───────────────────────────────────────────────────────────────────

model TaxDocument {
    id                   String   @id @default(cuid())
    userId               String
    taxYear              Int
    documentCategory     String
    formType             String?
    issuer               String?
    recipient            String?
    source               String
    originalFilename     String
    mimeType             String
    uploadedAt           DateTime @default(now())
    processingState      String
    parserProvider       String?
    parserVersion        String?
    extractionConfidence Float?
    originalStorageKey   String
    parsedStorageKey     String?
    reviewStatus         String
    userConfirmed        Boolean  @default(false)
    metadata             Json?
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    facts           TaxFact[]
    formExtractions TaxFormExtraction[]
    llmExtractionJobs TaxLlmExtractionJob[]

    @@index([userId, taxYear])
    @@index([userId, processingState])
}

model TaxFact {
    id                  String   @id @default(cuid())
    userId              String
    taxYear             Int
    category            String
    type                String
    key                 String
    value               Json
    valueType           String
    unit                String?
    currency            String?
    sourceType          String
    sourceDocumentId    String?
    sourceTransactionId String?
    sourceAccountId     String?
    sourceHoldingId     String?
    sourceManualEntryId String?
    sourceRealEstateId  String?
    sourceForm          String?
    sourceBox           String?
    sourcePage          Int?
    sourceText          String?
    confidence          Float
    extractionMethod    String
    status              String
    userConfirmed       Boolean  @default(false)
    metadata            Json?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    sourceDocument TaxDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

    @@index([userId, taxYear])
    @@index([userId, taxYear, key])
    @@index([sourceDocumentId])
}

model TaxFormExtraction {
    id            String   @id @default(cuid())
    userId        String
    documentId    String
    formType      String
    schemaVersion String
    payload       Json
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    document TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

    @@index([userId, documentId])
}

model TaxFactConflict {
    id              String   @id @default(cuid())
    userId          String
    taxYear         Int
    factKey         String
    factIds         String[]
    preferredFactId String?
    resolutionState String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, taxYear])
    @@unique([userId, taxYear, factKey])
}

model TaxLlmExtractionJob {
    id               String    @id @default(cuid())
    userId           String
    documentId       String
    status           String
    attemptCount     Int       @default(0)
    maxAttempts      Int       @default(5)
    documentType     String
    schemaVersion    String
    provider         String
    model            String
    modelRevision    String?
    inferenceServer  String?
    vllmVersion      String?
    lastErrorCode    String?
    lastErrorMessage String?
    createdAt        DateTime  @default(now())
    startedAt        DateTime?
    completedAt      DateTime?
    updatedAt        DateTime  @updatedAt

    user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    document TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

    @@index([userId, status])
    @@index([documentId, status])
    @@index([status, createdAt])
}

model MileageTrip {
    id                     String   @id @default(cuid())
    userId                 String
    startedAt              DateTime
    endedAt                DateTime
    distanceMeters         Float
    trackedDurationSeconds Int
    startLatitude          Float
    startLongitude         Float
    endLatitude            Float
    endLongitude           Float
    encodedPolylines       String[]
    businessPurpose        String
    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, startedAt])
}
