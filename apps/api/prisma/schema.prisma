generator client {
    provider      = "prisma-client-js"
    engineType    = "library"
    output        = "../generated/prisma"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// ─── Auth Models (NextAuth) ───────────────────────────────────────────────────

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String? @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.Text
    session_state            String?
    refresh_token_expires_in Int?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    username      String?   @unique
    password      String?

    trialStartedAt                     DateTime           @default(now())
    trialEndsAt                        DateTime           @default(dbgenerated("(now() + interval '30 days')"))
    subscriptionStatus                 SubscriptionStatus @default(NONE)
    // Authoritative consumer tier. `subscriptionPlan` is retained only so
    // released desktop/iOS builds keep parsing cached billing snapshots.
    subscriptionTier                   SubscriptionTier   @default(FREE)
    scheduledSubscriptionTier          SubscriptionTier?
    scheduledSubscriptionTierAt        DateTime?
    syncedAccountSelectionRequiredAt   DateTime?
    subscriptionPlan                   SubscriptionPlan   @default(NONE)
    syncAccessStatus                   SyncAccessStatus   @default(ACTIVE)
    subscriptionCurrentPeriodStart     DateTime?
    subscriptionCurrentPeriodEnd       DateTime?
    subscriptionCancelAtPeriodEnd      Boolean            @default(false)
    subscriptionCanceledAt             DateTime?
    subscriptionProviderCustomerId     String?            @unique
    subscriptionProviderSubscriptionId String?            @unique
    subscriptionProviderPriceId        String?
    subscriptionLastWebhookEventId     String?
    subscriptionInterval               String?
    /// Deprecated. Account count is no longer a billing quantity; this is kept
    /// only so released clients can validate cached billing snapshots.
    subscriptionBilledSyncedAccountCount Int              @default(0)
    referralCode                       String?            @unique
    referredByUserId                   String?
    referralBonusDaysGranted           Int                @default(0)
    successfulReferralCount            Int                @default(0)

    // 2FA fields
    twoFactorEnabled     Boolean @default(false)
    twoFactorSecret      String? @db.Text
    twoFactorBackupCodes String? @db.Text
    twoFactorVerified    Boolean @default(false)

    accounts                     Account[]
    sessions                     Session[]
    authSessions                 AuthSession[]
    transactions                 Transaction[]
    investments                  Investment[]
    realEstateInvestments        RealEstateInvestment[]
    forecastScenarios            ForecastScenario[]
    hashtags                     Hashtag[]
    rules                        TransactionRule[]
    settings                     UserSettings?
    categories                   Category[]
    categoryOverrides            CategoryOverride[]
    categoryBudgets              CategoryBudget[]
    demoOverlaySessions          DemoOverlaySession[]
    plaidItems                   PlaidItem[]
    plaidAccounts                PlaidAccount[]
    plaidHoldings                PlaidHolding[]
    financialConnections         FinancialConnection[]
    financialAccounts            FinancialAccount[]
    twoFactorTokens              TwoFactorToken[]
    refreshTokens                RefreshToken[]
    balanceSnapshots             BalanceSnapshot[]
    accountBalanceHistories      AccountBalanceHistory[]
    retailConnections            RetailConnection[]
    retailOrders                 RetailOrder[]
    householdInvitesOwned        HouseholdInvite[]           @relation("HouseholdInviteOwner")
    householdMembershipsOwned    HouseholdMembership[]       @relation("HouseholdMembershipOwner")
    householdMembershipsAsMember HouseholdMembership[]       @relation("HouseholdMembershipMember")
    profileLinksOwned            ProfileLink[]               @relation("ProfileLinkOwner")
    profileLinksAsProfile        ProfileLink[]               @relation("ProfileLinkProfile")
    dashboardWidgets             DashboardWidget[]
    financialProfileData         FinancialProfileData?
    referredBy                   User?                       @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
    referrals                    User[]                      @relation("UserReferrals")
    referralRedemptionsSent      ReferralRedemption[]        @relation("ReferralRedemptionsSent")
    referralRedemptionReceived   ReferralRedemption?         @relation("ReferralRedemptionReceived")
    memories                     Memory[]
    importMappingTemplates       ImportMappingTemplate[]
    agentConversations           AgentConversation[]
    mcpPersonalAccessTokens      McpPersonalAccessToken[]
    mcpOAuthAuthorizationCodes   McpOAuthAuthorizationCode[]
    mcpOAuthAccessTokens         McpOAuthAccessToken[]
    mcpToolCalls                 McpToolCall[]
    desktopMcpTunnels            DesktopMcpTunnel[]
    aiReports                    AiReport[]
    aiReportShares               AiReportShare[]
    createdPrompts               UserPrompt[]              @relation("PromptCreator")
    reviewedPrompts              UserPrompt[]              @relation("PromptReviewer")
    reviewedPromptRevisions      PromptRevision[]          @relation("PromptRevisionReviewer")
    promptPins                   PromptPin[]
    promptLaunchDailies          PromptLaunchDaily[]
    appleFinanceKitAccounts      AppleFinanceKitAccount[]
    inviteCodeRedemption         InviteCodeRedemption?
    inviteCodeAttempts           InviteCodeAttempt[]
    betaAccessRequests           BetaAccessRequest[]
    communityTipsAuthored        CommunityTip[]            @relation("CommunityTipAuthor")
    communityTipsReviewed        CommunityTip[]            @relation("CommunityTipReviewer")
    communityTipLikes            CommunityTipLike[]
    notificationRules            NotificationRule[]
    notificationPreference       NotificationPreference?
    notificationDeliveries       NotificationDelivery[]
    devicePushTokens             DevicePushToken[]
    notificationSuggestions              NotificationSuggestion[]
    expectedRecurringEvents              ExpectedRecurringEvent[]
    manualInvestmentBalanceAccruals      ManualInvestmentBalanceAccrual[]
    desktopAuthPairs             DesktopAuthPair[]
    retirementPlan                       RetirementPlan?
    retirementScenarios                  RetirementScenario[]
    retirementStandingRules              RetirementStandingRule[]
    retirementSpendingCategoryPlans      RetirementSpendingCategoryPlan[]
    taxDocuments                         TaxDocument[]
    taxFacts                             TaxFact[]
    taxFormExtractions                   TaxFormExtraction[]
    taxFactConflicts                     TaxFactConflict[]
    taxLlmExtractionJobs                 TaxLlmExtractionJob[]
    mileageTrips                         MileageTrip[]
    marketingAttribution                 MarketingAttribution?

    @@index([referredByUserId])
}

model MarketingAttribution {
    id     String @id @default(cuid())
    userId String @unique

    firstChannel     String
    firstPath        String
    firstTouchedAt   DateTime
    firstUtmSource   String?
    firstUtmMedium   String?
    firstUtmCampaign String?
    firstUtmTerm     String?
    firstUtmContent  String?

    latestChannel     String
    latestPath        String
    latestTouchedAt   DateTime
    latestUtmSource   String?
    latestUtmMedium   String?
    latestUtmCampaign String?
    latestUtmTerm     String?
    latestUtmContent  String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model TwoFactorToken {
    id      String   @id @default(cuid())
    userId  String
    token   String   @unique
    expires DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expires])
}

model RefreshToken {
    id         String    @id @default(cuid())
    userId     String
    sessionId  String? // Links to AuthSession for revocation tracking
    token      String    @unique
    expiresAt  DateTime
    createdAt  DateTime  @default(now())
    revokedAt  DateTime?
    deviceInfo String?   @db.Text // JSON: { platform, appVersion, deviceId }

    user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    session AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([userId, revokedAt])
    @@index([sessionId])
    @@index([token])
    @@index([expiresAt])
}

model AuthSession {
    id           String    @id @default(cuid())
    userId       String
    createdAt    DateTime  @default(now())
    lastActiveAt DateTime  @default(now())
    expiresAt    DateTime
    revokedAt    DateTime?
    deviceInfo   String?   @db.Text // JSON: { platform, appVersion, deviceId, userAgent }
    ipAddress    String?

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    refreshTokens RefreshToken[]

    @@index([userId])
    @@index([userId, revokedAt])
    @@index([expiresAt])
    @@index([lastActiveAt])
}

// ─── MCP Gateway Auth And Audit ───────────────────────────────────────────────

model McpPersonalAccessToken {
    id          String    @id @default(cuid())
    userId      String
    name        String
    tokenPrefix String
    tokenHash   String    @unique
    scopes      String[]  @default([])
    clientName  String?
    expiresAt   DateTime?
    revokedAt   DateTime?
    lastUsedAt  DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    toolCalls McpToolCall[]

    @@index([userId])
    @@index([userId, revokedAt])
    @@index([expiresAt])
    @@index([tokenHash])
}

model McpOAuthClient {
    id                String    @id @default(cuid())
    clientId          String    @unique
    clientSecretHash  String?
    name              String
    clientProfile     String
    redirectUris      String[]  @default([])
    scopes            String[]  @default([])
    grants            String[]  @default(["authorization_code", "refresh_token"])
    requestsPerMinute Int       @default(60)
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    revokedAt         DateTime?

    authorizationCodes McpOAuthAuthorizationCode[]
    accessTokens       McpOAuthAccessToken[]
    toolCalls          McpToolCall[]

    @@index([clientProfile])
    @@index([revokedAt])
}

model McpOAuthAuthorizationCode {
    id                  String    @id @default(cuid())
    userId              String
    oauthClientId       String
    codeHash            String    @unique
    codeChallenge       String
    codeChallengeMethod String
    redirectUri         String
    scopes              String[]  @default([])
    desktopPublicTunnelId String?
    expiresAt           DateTime
    consumedAt          DateTime?
    createdAt           DateTime  @default(now())
    ipAddress           String?
    userAgent           String?   @db.Text

    user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    oauthClient McpOAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([oauthClientId])
    @@index([expiresAt])
    @@index([consumedAt])
}

model McpOAuthAccessToken {
    id                    String    @id @default(cuid())
    userId                String
    oauthClientId         String
    tokenPrefix           String
    tokenHash             String    @unique
    refreshTokenHash      String?   @unique
    refreshTokenExpiresAt DateTime?
    scopes                String[]  @default([])
    desktopPublicTunnelId String?
    expiresAt             DateTime
    revokedAt             DateTime?
    lastUsedAt            DateTime?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    oauthClient McpOAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
    toolCalls   McpToolCall[]

    @@index([userId])
    @@index([desktopPublicTunnelId])
    @@index([oauthClientId])
    @@index([userId, revokedAt])
    @@index([expiresAt])
    @@index([refreshTokenExpiresAt])
    @@index([tokenHash])
}

model DesktopMcpTunnel {
    id             String    @id @default(cuid())
    userId         String
    deviceId       String
    publicTunnelId String    @unique
    label          String?
    revokedAt      DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, deviceId])
    @@index([userId])
}

model McpToolCall {
    id                    String   @id @default(cuid())
    userId                String?
    householdId           String?
    personalAccessTokenId String?
    oauthAccessTokenId    String?
    oauthClientId         String?
    clientName            String?
    clientProfile         String?
    toolName              String
    requiredScopes        String[] @default([])
    grantedScopes         String[] @default([])
    inputHash             String?
    inputSummary          Json?
    outputSummary         Json?
    status                String
    durationMs            Int
    errorCode             String?
    rateLimited           Boolean  @default(false)
    createdAt             DateTime @default(now())

    user                User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
    personalAccessToken McpPersonalAccessToken? @relation(fields: [personalAccessTokenId], references: [id], onDelete: SetNull)
    oauthAccessToken    McpOAuthAccessToken?    @relation(fields: [oauthAccessTokenId], references: [id], onDelete: SetNull)
    oauthClient         McpOAuthClient?         @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt])
    @@index([personalAccessTokenId, createdAt])
    @@index([oauthAccessTokenId, createdAt])
    @@index([oauthClientId, createdAt])
    @@index([toolName, createdAt])
    @@index([status, createdAt])
}

// ─── Financial Data ───────────────────────────────────────────────────────────

enum TransactionType {
    INCOME
    EXPENSE
}

enum HouseholdInviteStatus {
    PENDING
    ACCEPTED
    REVOKED
    EXPIRED
}

enum HouseholdMembershipStatus {
    ACTIVE
    REMOVED
}

enum ProfileKind {
    PERSONAL
    FAMILY
    BUSINESS
}

enum BusinessType {
    SOLE_PROPRIETOR
    SINGLE_MEMBER_LLC
    MULTI_MEMBER_LLC_PARTNERSHIP
    S_CORPORATION
    C_CORPORATION
}

model ProfileLink {
    id                     String        @id @default(cuid())
    ownerUserId            String
    profileUserId          String
    kind                   ProfileKind
    displayName            String
    includeInOwnerNetWorth Boolean       @default(false)
    businessType           BusinessType?
    createdAt              DateTime      @default(now())
    archivedAt             DateTime?
    // Distinct from archivedAt: archived means the user hid the profile and it
    // drops out of every list, while a restricted profile stays visible and
    // read-only so the owner can see their data and an upgrade path.
    entitlementRestrictedAt DateTime?

    ownerUser              User                           @relation("ProfileLinkOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
    profileUser            User                           @relation("ProfileLinkProfile", fields: [profileUserId], references: [id], onDelete: Cascade)
    householdAccessGrants  HouseholdProfileAccess[]
    householdInviteGrants  HouseholdInviteProfileAccess[]

    @@unique([ownerUserId, profileUserId])
    @@index([ownerUserId])
    @@index([ownerUserId, archivedAt])
}

enum SubscriptionStatus {
    NONE
    ACTIVE
    PAST_DUE
    CANCELED
    UNPAID
}

enum SubscriptionTier {
    FREE
    LITE
    PRO
    BUSINESS_OWNER
}

/// Deprecated in favor of SubscriptionTier + subscriptionInterval. Still written
/// so released desktop and iOS builds can validate cached billing snapshots.
enum SubscriptionPlan {
    NONE
    MONTHLY
    ANNUAL
    COMPLIMENTARY
}

enum SyncAccessStatus {
    ACTIVE
    PAUSED_TRIAL_EXPIRED
}

model HouseholdInvite {
    id           String                @id @default(cuid())
    ownerUserId  String
    inviteeName  String
    inviteeEmail String
    tokenHash    String
    status       HouseholdInviteStatus @default(PENDING)
    expiresAt    DateTime
    sentAt       DateTime?
    acceptedAt   DateTime?
    revokedAt    DateTime?
    createdAt    DateTime              @default(now())
    updatedAt    DateTime              @updatedAt

    ownerUser     User                           @relation("HouseholdInviteOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
    profileAccess HouseholdInviteProfileAccess[]

    @@unique([tokenHash])
    @@index([ownerUserId, status, expiresAt])
    @@index([inviteeEmail])
}

model HouseholdMembership {
    id           String                    @id @default(cuid())
    ownerUserId  String
    memberUserId String
    status       HouseholdMembershipStatus @default(ACTIVE)
    createdAt    DateTime                  @default(now())
    updatedAt    DateTime                  @updatedAt
    removedAt    DateTime?

    ownerUser     User                      @relation("HouseholdMembershipOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
    memberUser    User                      @relation("HouseholdMembershipMember", fields: [memberUserId], references: [id], onDelete: Cascade)
    profileAccess HouseholdProfileAccess[]

    @@unique([ownerUserId, memberUserId])
    @@index([ownerUserId])
    @@index([ownerUserId, status])
    @@index([memberUserId])
    @@index([memberUserId, status])
}

model HouseholdInviteProfileAccess {
    id            String   @id @default(cuid())
    inviteId      String
    profileLinkId String
    createdAt     DateTime @default(now())

    invite      HouseholdInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
    profileLink ProfileLink     @relation(fields: [profileLinkId], references: [id], onDelete: Cascade)

    @@unique([inviteId, profileLinkId])
    @@index([inviteId])
    @@index([profileLinkId])
}

model HouseholdProfileAccess {
    id            String   @id @default(cuid())
    membershipId  String
    profileLinkId String
    createdAt     DateTime @default(now())

    membership  HouseholdMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
    profileLink ProfileLink         @relation(fields: [profileLinkId], references: [id], onDelete: Cascade)

    @@unique([membershipId, profileLinkId])
    @@index([membershipId])
    @@index([profileLinkId])
}

enum TransactionSource {
    CSV
    PLAID
    MX
    FINICITY
    MANUAL
    APPLE_FINANCEKIT
}

enum AppleFinanceKitAccountStatus {
    ACTIVE
    DISCONNECTED
}

enum FinancialDataProvider {
    PLAID
    MX
    FINICITY
}

enum ConnectionStatus {
    ACTIVE
    DEGRADED
    REAUTH_REQUIRED
    DISCONNECTED
    ERROR
    MIGRATING
}

enum SyncTrigger {
    WEBHOOK
    SCHEDULED
    USER_REFRESH
    INITIAL_LINK
    BACKFILL
    PROVIDER_SWITCH
}

enum SyncStatus {
    PENDING
    RUNNING
    SUCCESS
    FAILED
    PARTIAL_SUCCESS
    SKIPPED
}

enum ProviderWebhookStatus {
    RECEIVED
    VERIFIED
    REJECTED
    QUEUED
    PROCESSED
    FAILED
    IGNORED_DUPLICATE
}

enum ProviderSyncJobStatus {
    PENDING
    RUNNING
    SUCCESS
    FAILED
    CANCELLED
}

enum InstitutionMatchConfidence {
    MANUAL
    HIGH
    MEDIUM
    LOW
    UNMATCHED
}

enum InstitutionCategory {
    BANK
    CREDIT_CARD
    INVESTMENT
    CREDIT_UNION
    FINTECH
    CRYPTO
    LOAN
    PAYROLL
    UNKNOWN
}

model Transaction {
    id     String @id @default(cuid())
    userId String

    // Legacy compatibility — kept for backward compat during rollout
    date DateTime

    // App canonical timeline date for Plaid-imported rows.
    // Sourced from Plaid `date` field for sorting/display uniformity.
    // NOT guaranteed to be bank settlement date in every institution context.
    postedDate DateTime?

    // Plaid `authorized_date` — distinct from postedDate, do not conflate
    authorizedDate DateTime?

    // Money
    amount                 Decimal @db.Decimal(14, 2)
    isoCurrencyCode        String?
    unofficialCurrencyCode String?

    // App classification
    type                TransactionType
    category            String          @default("OTHER")
    categoryId          String?
    description         String?
    originalDescription String?
    notes               String?
    merchantName        String?
    account             String?
    paymentChannel      String?

    // Import/source tracking
    importId                 String?
    // v1 uniqueness: [userId, externalTransactionId]
    // Future: may need [userId, source, externalTransactionId] for multi-provider normalization
    source                   TransactionSource      @default(CSV)
    externalTransactionId    String?
    pendingTransactionId     String?
    plaidAccountId           String?
    plaidItemId              String?
    appleFinanceKitAccountId String?
    financialConnectionId    String?
    financialAccountId       String?
    dataProvider             FinancialDataProvider?
    providerAccountId        String?
    providerTransactionId    String?
    accountFingerprint       String?
    dedupeFingerprint        String?
    sourceAccountId          String?
    importBatchId            String?
    pending                  Boolean                @default(false)
    hidden                   Boolean                @default(false)
    removedAt                DateTime?
    /// Plaid Location object (address, city, region, postal_code, country, lat, lon, store_number)
    location                 Json?
    raw                      Json?
    rawProviderPayload       Json?

    // Split tracking for app-managed split rows.
    splitGroupId        String?
    splitParentId       String?
    splitOriginalAmount Decimal? @db.Decimal(14, 2)

    // Internal transfer pairing: links the two legs of a same-amount transfer
    // between the user's own connected accounts. autoHiddenAsTransfer marks a
    // hide performed by the pairing system so user-initiated hides are preserved.
    transferPairId       String?
    autoHiddenAsTransfer Boolean @default(false)

    // Set when Amazon extension scrape data is linked onto this bank row.
    amazonRetailEnrichedAt DateTime?

    // Rule that was applied to this transaction (one-to-one relationship)
    appliedRuleId String?

    user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
    hashtags               TransactionHashtag[]
    ruleApplications       TransactionRuleApplication[]
    retailOrderItems       RetailOrderItem[]
    categoryRef            Category?                    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    plaidAccount           PlaidAccount?                @relation(fields: [plaidAccountId], references: [id], onDelete: SetNull)
    plaidItem              PlaidItem?                   @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
    appleFinanceKitAccount AppleFinanceKitAccount?      @relation(fields: [appleFinanceKitAccountId], references: [id], onDelete: SetNull)
    financialAccount       FinancialAccount?            @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
    financialConnection    FinancialConnection?         @relation(fields: [financialConnectionId], references: [id], onDelete: SetNull)
    appliedRule            TransactionRule?             @relation("AppliedToTransaction", fields: [appliedRuleId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, externalTransactionId], name: "unique_external_tx")
    @@index([userId, date])
    @@index([userId, postedDate])
    @@index([userId, authorizedDate])
    @@index([userId, type])
    @@index([userId, category])
    @@index([userId, categoryId])
    @@index([userId, source])
    @@index([plaidAccountId])
    @@index([plaidItemId])
    @@index([appleFinanceKitAccountId])
    @@index([financialConnectionId])
    @@index([financialAccountId])
    @@index([dataProvider])
    @@index([providerAccountId])
    @@index([providerTransactionId])
    @@index([dedupeFingerprint])
    @@index([appliedRuleId])
    @@index([userId, splitGroupId])
    @@index([splitParentId])
    @@index([userId, type, date])
    @@index([userId, type, categoryId, date])
    @@index([userId, hidden, date])
    @@index([userId, removedAt])
    @@index([userId, transferPairId])
    @@index([userId, type, amount, postedDate])
}

enum CategoryParent {
    FIXED
    FLEXIBLE
    NON_MONTHLY
}

model Category {
    id             String          @id @default(cuid())
    userId         String?
    name           String
    icon           String?
    color          String          @default("#71717A")
    isDefault      Boolean          @default(false)
    isHidden       Boolean          @default(false)
    sortOrder      Int             @default(0)
    parentCategory CategoryParent?

    user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
    transactions Transaction[]
    budgets      CategoryBudget[]
    overrides    CategoryOverride[]

    @@index([userId])
    @@index([userId, isHidden])
}

model CategoryOverride {
    id             String          @id @default(cuid())
    userId         String
    categoryId     String
    name           String?
    icon           String?
    color          String?
    isHidden       Boolean?
    isRemoved      Boolean          @default(false)
    parentCategory CategoryParent?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@unique([userId, categoryId])
    @@index([userId])
    @@index([categoryId])
}

model CategoryBudget {
    id              String   @id @default(cuid())
    userId          String
    categoryId      String
    monthlyGoal     Decimal  @db.Decimal(14, 2)
    alertsEnabled   Boolean  @default(true)
    alertThresholds Json     @default("[75, 100]")
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

    @@unique([userId, categoryId])
    @@index([userId])
}

model Hashtag {
    id             String   @id @default(cuid())
    userId         String
    name           String
    normalizedName String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
    transactions TransactionHashtag[]
    ruleActions  TransactionRuleAction[]

    @@unique([userId, normalizedName])
    @@index([userId])
}

model TransactionHashtag {
    transactionId String
    hashtagId     String
    createdAt     DateTime @default(now())

    transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    hashtag     Hashtag     @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

    @@id([transactionId, hashtagId])
    @@index([hashtagId])
}

// ─── Rules Engine ─────────────────────────────────────────────────────────────

enum RuleField {
    MERCHANT
    DESCRIPTION
    AMOUNT
    CATEGORY
    DATE
    ACCOUNT
    NOTES
}

enum RuleOperator {
    CONTAINS
    NOT_CONTAINS
    STARTS_WITH
    ENDS_WITH
    EQUALS
    NOT_EQUALS
    GREATER_THAN
    GREATER_THAN_OR_EQUAL
    LESS_THAN
    LESS_THAN_OR_EQUAL
    IS_EMPTY
    IS_NOT_EMPTY
    BEFORE
    AFTER
    ON
    BETWEEN
}

enum RuleActionType {
    SET_CATEGORY
    SET_DESCRIPTION
    SET_TYPE
    ADD_HASHTAG
}

enum RuleApplyModePreference {
    ALWAYS_ASK
    APPLY_HISTORICAL
    FUTURE_ONLY
}

enum RuleExecutionPreference {
    ALWAYS_ASK
    APPLY_HISTORICAL
    FUTURE_ONLY
}

enum RuleMatch {
    ALL
    ANY
}

model TransactionRule {
    id                  String                   @id @default(cuid())
    userId              String
    name                String
    isActive            Boolean                  @default(true)
    priority            Int
    match               RuleMatch                @default(ALL)
    applyModePreference RuleApplyModePreference?
    createdAt           DateTime                 @default(now())
    updatedAt           DateTime                 @updatedAt

    user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
    conditionGroups     TransactionRuleConditionGroup[]
    conditions          TransactionRuleCondition[]
    actions             TransactionRuleAction[]
    applications        TransactionRuleApplication[]
    appliedTransactions Transaction[]                @relation("AppliedToTransaction")

    @@index([userId, isActive, priority])
}

model TransactionRuleConditionGroup {
    id        String    @id @default(cuid())
    ruleId    String
    sortOrder Int
    match     RuleMatch @default(ALL)

    rule       TransactionRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
    conditions TransactionRuleCondition[]

    @@index([ruleId, sortOrder])
}

model TransactionRuleCondition {
    id                String       @id @default(cuid())
    ruleId            String
    groupId           String
    sortOrder         Int
    field             RuleField
    operator          RuleOperator
    valueText         String?
    valueNumber       Float?
    valueDate         DateTime?
    secondValueText   String?
    secondValueNumber Float?
    secondValueDate   DateTime?

    rule  TransactionRule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
    group TransactionRuleConditionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@index([ruleId, sortOrder])
    @@index([groupId, sortOrder])
}

model TransactionRuleAction {
    id        String         @id @default(cuid())
    ruleId    String
    sortOrder Int
    type      RuleActionType
    valueText String?
    hashtagId String?

    rule    TransactionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
    hashtag Hashtag?        @relation(fields: [hashtagId], references: [id], onDelete: SetNull)

    @@index([ruleId, sortOrder])
}

model TransactionRuleApplication {
    id                    String   @id @default(cuid())
    transactionId         String
    ruleId                String
    appliedAt             DateTime @default(now())
    wasHistoricalBackfill Boolean  @default(false)

    transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    rule        TransactionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

    @@index([transactionId])
    @@index([ruleId])
}

model UserSettings {
    id                            String                  @id @default(cuid())
    userId                        String                  @unique
    ruleExecutionPreference       RuleExecutionPreference @default(ALWAYS_ASK)
    hasCompletedInitialOnboarding Boolean                 @default(false)
    onboardingGoals               String[]                @default([])
    currentAge                    Int?
    retirementAge                 Int?
    referralSource                String?
    referralSourceOther           String?
    inviteCodeGatePassedAt        DateTime?
    memoryEnabled                 Boolean                 @default(true)
    showCommunityTipsOnTransactions Boolean               @default(true)
    setupGuideDismissedAt         DateTime?
    setupGuideCompletedSteps      String[]                @default([])
    extensionMetadata             Json?
    createdAt                     DateTime                @default(now())
    updatedAt                     DateTime                @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

