    REAL_ESTATE
}

model BalanceSnapshot {
    id       String                @id @default(cuid())
    userId   String
    date     DateTime
    source   BalanceSnapshotSource
    sourceId String
    balance  Float

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, date, source, sourceId])
