    referrerUserId      String
    referredUserId      String   @unique
    qualifiedAt         DateTime @default(now())
    bonusDaysToReferrer Int      @default(7)
    bonusDaysToReferred Int      @default(7)
    createdAt           DateTime @default(now())

    referrer User @relation("ReferralRedemptionsSent", fields: [referrerUserId], references: [id], onDelete: Cascade)
    referred User @relation("ReferralRedemptionReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

    @@index([referrerUserId])
}

model InviteCode {
    id              String    @id @default(cuid())
    code            String    @unique
    description     String?
    isActive        Boolean   @default(true)
    maxRedemptions  Int?
    redemptionCount Int       @default(0)
    expiresAt       DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    redemptions        InviteCodeRedemption[]
    desktopRedemptions DesktopInviteCodeRedemption[]
}

model InviteCodeRedemption {
    id           String   @id @default(cuid())
    inviteCodeId String
    userId       String   @unique
    redeemedAt   DateTime @default(now())

    inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([inviteCodeId])
}

model InviteCodeAttempt {
    id        String   @id @default(cuid())
    userId    String
    wasValid  Boolean  @default(false)
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, createdAt])
}

model DesktopInviteCodeRedemption {
    id               String   @id @default(cuid())
    inviteCodeId     String
    desktopDeviceId  String   @unique
    redeemedAt       DateTime @default(now())

    inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

    @@index([inviteCodeId])
}

model DesktopInviteCodeAttempt {
    id               String   @id @default(cuid())
    desktopDeviceId  String
    wasValid         Boolean  @default(false)
    createdAt        DateTime @default(now())

    @@index([desktopDeviceId, createdAt])
}

// ─── Dashboard Customization ──────────────────────────────────────────────────

model DashboardWidget {
    id         String  @id @default(cuid())
    userId     String
    widgetType String // e.g., "net-worth-chart", "spending-by-category"
    order      Int // 0-based position in the grid
    isVisible  Boolean @default(true)
