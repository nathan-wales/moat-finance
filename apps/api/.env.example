# Since the ".env.local" file is gitignored, you can use this file to
# build a new ".env.local" file when you clone the repo for the API server.
# Keep this file up-to-date when you add new variables.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env.local" and populate it with your secrets.

# Node Environment
NODE_ENV="development"

# CORS - Web app origin for same-site subdomain requests
# Local dev: http://localhost:3000
# Production has NO hardcoded origins: WEB_ORIGIN / APP_BASE_URL are always
# allowed; list any extra browser origins (marketing site, staging, etc.) in
# CORS_ORIGINS (alias: CORS_ALLOWED_ORIGINS), comma-separated.
CORS_ORIGINS=""
WEB_ORIGIN="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Admin allowlist (comma-separated emails). No default — unset means no admins.
# Must match ADMIN_EMAILS in apps/web.
ADMIN_EMAILS=""

# Sign-up lock (enforced here for web, desktop, and iOS sign-ups). Sign-ups are
# open unless SIGNUPS_ENABLED is exactly "false". While closed, only emails in
# SIGNUP_ALLOWED_EMAILS (comma-separated, case-insensitive) can create an
# account. Existing users and demo mode are unaffected.
# SIGNUPS_ENABLED="false"
# SIGNUP_ALLOWED_EMAILS="you@example.com"

# Origin the API uses to call itself (cron kicks). Defaults to VERCEL_URL on
# Vercel, else http://127.0.0.1:$PORT (3001).
# API_INTERNAL_ORIGIN="http://127.0.0.1:3001"

# Log environment label (local | preview | production). Defaults from
# VERCEL_ENV / NODE_ENV.
# APP_ENV="production"

# Prisma / Neon Postgres
# Local development only. Never use production credentials here.
# Use the Neon dev/local database, for example moat-dev.
#
# End-state RLS cutover (staging/production):
#   DATABASE_URL  -> moat_app pooled role (NOSUPERUSER, NOBYPASSRLS, not table owner)
#   DIRECT_URL    -> migration/owner direct role
# See docs/security/row-level-security-deployment.md
DATABASE_URL="postgresql://USER:PASSWORD@HOST/moat_dev?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/moat_dev?sslmode=require"
# Optional explicit migration URL (defaults to DIRECT_URL / owner credentials in CI)
# DATABASE_MIGRATION_URL="postgresql://OWNER:PASSWORD@HOST/moat_dev?sslmode=require"
# Defaults to true. Set false only after RLS has been disabled — FORCE applies
# to the table owner too, so clearing this while FORCE is on denies everything.
MOAT_DATABASE_ACTOR_CONTEXT="true"
# Optional. Background jobs need app.actor_type=service as a session startup
# option. Defaults to DATABASE_URL. Point at the unpooled URL if the pooler
# strips options (watch for service_db_startup_option_ignored in logs).
# SERVICE_DATABASE_URL="postgresql://USER:PASSWORD@HOST/moat_dev?sslmode=require"
# Optional request-transaction bounds (milliseconds).
# MOAT_DATABASE_ACTOR_TIMEOUT_MS="60000"
# MOAT_DATABASE_ACTOR_MAX_WAIT_MS="5000"
# Origin used to fan-out provider sync job kicks after enqueue
# (POST /api/cron/process-provider-sync-jobs). Defaults to
# https://$VERCEL_URL in production, or http://127.0.0.1:3001 locally.
# API_INTERNAL_ORIGIN="http://127.0.0.1:3001"

# ─── REQUIRED IN PRODUCTION ──────────────────────────────────────────────────

# NextAuth / Auth Configuration
# Generate a new secret: npx auth secret
# REQUIRED in production — app will refuse to start without it.
AUTH_SECRET=""

# Google OAuth Provider (if using OAuth)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Native app client IDs — required for iOS/Android Google Sign-In token verification
AUTH_GOOGLE_ID_IOS=""
AUTH_GOOGLE_ID_ANDROID=""

# Encryption key for sensitive data (Plaid tokens, 2FA secrets, etc.)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production — app will refuse to start without it.
ENCRYPTION_KEY=""

# Cron job secret for the cleanup-demo-sessions endpoint.
# Generate a random secret: openssl rand -hex 32
# REQUIRED — the endpoint returns 401 for any request without a valid Bearer token.
CRON_SECRET=""

# MCP personal access token hashing pepper.
# Generate a random secret: openssl rand -hex 32
# REQUIRED in production for API-created MCP tokens.
MCP_TOKEN_PEPPER=""

# Desktop remote MCP tunnel. Required only when desktop-remote-mcp is enabled.
# Generate an Ed25519 key pair and put the PKCS8 DER as base64.
# DESKTOP_TUNNEL_JWT_PRIVATE_KEY=""
# Shared with the tunnel Worker. openssl rand -hex 32
# TUNNEL_INTROSPECT_SECRET=""

# Private Cloudflare R2 bucket for tax document originals (cloud API + MCP).
# No public access, no r2.dev URL, no custom domain. Token: Object Read & Write
# on this bucket only. Taxes is a parked product: these are required in
# production only when TAXES_PRODUCT_ENABLED is turned back on.
TAX_R2_ACCOUNT_ID=""
TAX_R2_ACCESS_KEY_ID=""
TAX_R2_SECRET_ACCESS_KEY=""
TAX_R2_BUCKET="tax-documents"
# Optional local-only fallback when TAX_R2_* are unset (non-production).
# TAX_FILE_STORAGE_DIR="/tmp/moat-tax-files"

# Optional private Docling parser (parked Taxes product). When unset, the API
# uses the local heuristic parser and never sends documents to a third-party
# processing API.
# DOCLING_PARSER_URL="https://<your-docling-service>"
# DOCLING_RUNTIME_SERVICE_ACCOUNT="<service-account-email>"
# DOCLING_PARSE_AUDIENCE="https://<your-api-host>"
# Local Docker only (host 18081 — do not bind over another service on 8080):
# DOCLING_PARSER_URL="http://127.0.0.1:18081"
# DOCLING_PARSER_ALLOW_INSECURE_LOCAL="true"
# Queue/drain parse mode. Production enables this automatically when Docling is
# configured. Do not set true against localhost.
# TAX_PARSE_ASYNC="false"

# Private Qwen W-2 extraction. When true, W-2 parses wait for Qwen after Docling.
# TAX_LLM_EXTRACTION_ENABLED="false"
# TAX_LLM_CONTROLLER_URL="https://<your-tax-llm-controller>"
# TAX_LLM_ENCRYPTION_KEY_VERSION="v1"
# TAX_LLM_ENCRYPTION_KEY_v1=""
# TAX_LLM_RUNTIME_SERVICE_ACCOUNT="<controller-sa-email>,<worker-sa-email>"
# TAX_LLM_PARSE_AUDIENCE="https://<your-api-host>"
# TAX_LLM_GCP_CLIENT_EMAIL="<publisher-sa-email>"
# TAX_LLM_GCP_PRIVATE_KEY=""

# Desktop vault recovery email hashing pepper.
# Generate a random secret: openssl rand -hex 32
# Falls back to MCP_TOKEN_PEPPER when unset.
VAULT_RECOVERY_PEPPER=""

# ─── PROVIDER-SPECIFIC SECRETS (required when provider is enabled) ────────────

# Plaid Integration (bring your own keys; see docs/self-hosting.md)
# PLAID_CLIENT_ID and PLAID_SECRET are required when PLAID_WEBHOOK is set.
# Register at: https://dashboard.plaid.com/signup
# PLAID_ENV options: sandbox | production
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
# Link products are hardcoded in apps/api/src/server/plaid/link-products.ts
# (transactions required, investments optional). Do not set PLAID_PRODUCTS.
PLAID_COUNTRY_CODES="US"
# Optional. Must be allow-listed in the Plaid dashboard when set.
PLAID_REDIRECT_URI=""
# Public HTTPS webhook URL: <public API origin>/api/webhooks/plaid. When unset,
# it is derived from API_BASE_URL / PUBLIC_API_URL if that origin is https://.
PLAID_WEBHOOK=""

# Finicity (Mastercard Open Banking) — optional, off unless
# ENABLE_FINICITY_CONNECTIONS="true". Plaid is the default provider.
# ENABLE_FINICITY_CONNECTIONS="false"
# FINICITY_BASE_URL="https://api.finicity.com"
# FINICITY_CONNECT_URL=""
# FINICITY_WEBHOOK_SECRET is required in production when Finicity is enabled.
# Without it, all Finicity webhook events are rejected in production.
FINICITY_APP_KEY=""
FINICITY_PARTNER_ID=""
FINICITY_PARTNER_SECRET=""
FINICITY_WEBHOOK_SECRET=""

# MX Technologies — optional, off unless ENABLE_MX_CONNECTIONS="true".
# ENABLE_MX_CONNECTIONS="false"
# MX_BASE_URL="https://api.mx.com"
# MX_CONNECT_WIDGET_URL=""
# MX_WEBHOOK_BASIC_AUTH_USERNAME + PASSWORD are required in production when MX is enabled.
# Without them, all MX webhook events are rejected in production.
MX_CLIENT_ID=""
MX_API_KEY=""
MX_WEBHOOK_BASIC_AUTH_USERNAME=""
MX_WEBHOOK_BASIC_AUTH_PASSWORD=""

# ─── OPTIONAL / FEATURE-GATED ─────────────────────────────────────────────────

# Bank sync feature flags
# Enable billable Plaid /accounts/balance/get for all users (default: admin-only)
ENABLE_REALTIME_BALANCE_SYNC="false"
# Comma-separated user IDs for admin-only sync feature flags (realtime balance, etc.)
# Admin routes (community tips / prompt moderation / etc.) use the hardcoded
# ADMIN_EMAILS allowlist in apps/api/src/server/lib/admin-access.ts instead.
ADMIN_USER_IDS=""

# Posthog
NEXT_PUBLIC_POSTHOG_KEY=public_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
# Server-side flag evaluation (falls back to NEXT_PUBLIC_POSTHOG_* if unset)
POSTHOG_API_KEY=""
POSTHOG_HOST=""

# Axiom
AXIOM_TOKEN=axiom_token_here
AXIOM_DATASET=moat_finance
APP_VERSION=0.1.0

# Resend (email service)
RESEND_API_KEY="api_key_here"
EMAIL_FROM="Moat Finance <hello@example.com>"
FEEDBACK_RECIPIENT="support@example.com"

# GitHub feedback issue sync (optional)
# Set GITHUB_FEEDBACK_ENABLED=true and provide a fine-grained PAT scoped to
# Issues read/write on the target repo only.
GITHUB_FEEDBACK_ENABLED="false"
GITHUB_FEEDBACK_TOKEN=""
GITHUB_FEEDBACK_OWNER=""
GITHUB_FEEDBACK_REPO=""
# Optional aliases supported by the API:
# GITHUB_FEEDBACK_REPO_OWNER=""
# GITHUB_FEEDBACK_REPO_NAME=""
# Optional comma-separated base labels (type-specific labels are added automatically)
GITHUB_FEEDBACK_LABELS="feedback"

OPENAI_API_KEY=""
