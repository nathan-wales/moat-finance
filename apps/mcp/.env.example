# Prisma / Neon Postgres (dev)
# For RLS cutover, use the restricted moat_app role (see docs/security/row-level-security-deployment.md).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/moat_dev?sslmode=require&pgbouncer=true"
# Defaults to true. Set false only for emergency rollback on a table-owner DATABASE_URL.
MOAT_DATABASE_ACTOR_CONTEXT="true"

# For local stdio mode — generate a PAT via the web app UI (or seed script)
MOAT_MCP_TOKEN=moat_dev_xxxxxxxxxxxxxxxx

# Optional, defaults shown
MCP_BASE_URL=http://localhost:3010
WEB_APP_URL=http://localhost:3000
MCP_PORT=3010
MCP_TOKEN_PEPPER=replace_with_at_least_32_random_chars_for_token_hashing

# Optional — hosted consumer MCP OAuth clients.
# ChatGPT defaults to chatgpt.com and validates /connector/oauth/* callbacks.
# Cursor defaults to www.cursor.com,cursor.com and also allows Desktop
# http://localhost|127.0.0.1:<any-port>/callback|/oauth/callback plus
# cursor://anysphere.cursor-mcp/oauth/callback.
# Claude defaults to claude.ai,claude.com and validates /api/mcp/auth_callback.
# Configure Gemini/other hosted redirect hosts once those apps provide their callback domains.
MCP_OAUTH_CHATGPT_REDIRECT_HOSTS=chatgpt.com
MCP_OAUTH_CURSOR_REDIRECT_HOSTS=www.cursor.com,cursor.com
MCP_OAUTH_CLAUDE_REDIRECT_HOSTS=claude.ai,claude.com
MCP_OAUTH_GEMINI_REDIRECT_HOSTS=
MCP_OAUTH_CONSUMER_REDIRECT_HOSTS=

# Optional — rate limiting (Upstash Redis). Skip for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — logging
AXIOM_TOKEN=
AXIOM_DATASET=moat_finance
APP_VERSION=0.0.0

# Private Cloudflare R2 bucket for tax document originals (same values as apps/api).
# Required in production when includeParsedText reads stored files. Do not reuse
# the public desktop-downloads bucket.
TAX_R2_ACCOUNT_ID=
TAX_R2_ACCESS_KEY_ID=
TAX_R2_SECRET_ACCESS_KEY=
TAX_R2_BUCKET=tax-documents

# OpenAI Apps / plugin domain verification token from the submission portal.
# Served as plain text at GET /.well-known/openai-apps-challenge
# Production URL: https://mcp.moatfinance.ai/.well-known/openai-apps-challenge
OPENAI_APPS_CHALLENGE_TOKEN=