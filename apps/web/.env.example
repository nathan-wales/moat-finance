# Since the ".env.local" file is gitignored, you can use this file to
# build a new ".env.local" file when you clone the repo for the web app.
# Keep this file up-to-date when you add new variables.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env.local" and populate it with your secrets.

# When adding additional environment variables, the schema in "src/env.js"
# should be updated accordingly.

# Next Auth
# Generate a new secret: npx auth secret
AUTH_SECRET=""

# Session cookie Domain attribute. Set (e.g. ".example.com") only when the web
# app and API run on sibling subdomains and must share the session cookie.
# Unset → host-only cookie.
# AUTH_COOKIE_DOMAIN=""

# Admin allowlist (comma-separated emails, server-only). No default — unset
# means no admins. Keep in sync with ADMIN_EMAILS in apps/api.
ADMIN_EMAILS=""

# Prisma / Neon Postgres (dev)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/moat_dev?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/moat_dev?sslmode=require"

# Google OAuth Provider
# Create credentials at: https://console.developers.google.com/
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# REST API Server
# URL of the separate API server for REST calls
# Local dev: http://localhost:3001
# Production: https://api.moatfinance.ai
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Public Streamable HTTP MCP endpoint shown in Settings → AI access (build time).
# Unset → hosted endpoint. Self-hosters: https://<your-mcp-host>/mcp
# NEXT_PUBLIC_MCP_URL=""

# Logo.dev — publishable key for JIT institution logos (safe for client-side use)
# Register at: https://www.logo.dev
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=""

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Moat Retail Sync Chrome extension id (from chrome://extensions)
NEXT_PUBLIC_MOAT_RETAIL_EXTENSION_ID=""

# Posthog
NEXT_PUBLIC_POSTHOG_KEY=public_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Axiom
AXIOM_TOKEN=axiom_token_here
AXIOM_DATASET=moat_finance
APP_VERSION=0.1.0
NEXT_PUBLIC_APP_VERSION=0.1.0
